# ---------- NUM Portal settings (copy to .env and fill in) ----------
# PostgreSQL. On the study server the database listens on the Docker bridge address 172.17.0.1
DATABASE_URL="postgresql://numportal:change-me@127.0.0.1:5432/numportal_live"

# Random long string used to sign login cookies (e.g. `openssl rand -hex 32`)
SESSION_SECRET="change-me-to-a-long-random-string"

# Shown on the dashboard
APP_VERSION="dev"

# Teachers may create their own account at /register (username + password + confirm password).
# Set to "false" to close sign-up once the evaluator accounts for the experiment exist.
REGISTRATION_OPEN="true"

# Highest evaluator number that has a preview address.
# Keep this equal to the number of tester-N lines in infra/cloudflared-config.yml.
MAX_TESTERS="10"

# ---------- Claude API (prompt-to-deploy) ----------
# Leave ANTHROPIC_API_KEY empty to use the built-in demo AI (no external calls)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"

# ---------- GitLab ----------
# Leave GITLAB_TOKEN empty to run in LOCAL MODE (changes are saved on disk and
# shown at /preview/<n> instead of being committed to GitLab).
GITLAB_URL="https://gitlab.com"
GITLAB_PROJECT_ID=""            # numeric project id or "group%2Fproject"
GITLAB_TOKEN=""                 # project access token with the `api` scope (role: Developer)
GITLAB_DEFAULT_BRANCH="main"
GITLAB_WEBHOOK_SECRET="change-me-webhook-secret"
GITLAB_PROJECT_URL=""           # e.g. https://gitlab.com/your-name/num-portal (for links on the dashboard)

# ---------- Public addresses ----------
# Evaluator N's preview link becomes https://tester-N.<PREVIEW_DOMAIN>
PREVIEW_DOMAIN="example.com"

# ---------- Experiment ----------
# Number of human actions in one Method B release (merge + approve)
EXP_B_STEPS="2"

# ---------- Local mode only ----------
LOCAL_WORKSPACE_DIR=".local-workspaces"
